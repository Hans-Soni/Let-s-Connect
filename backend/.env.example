PORT=5002
MONGO_URI=your_mongo_uri_here
NODE_ENV=development

# ── Rotating key system ────────────────────────────────────────────────────
# Master key that seals all rotating secrets stored in MongoDB.
# Generate once with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this ONLY in your host's secret manager / environment — NEVER commit it.
KEY_MASTER_KEY=your_64_hex_char_master_key_here

# Legacy keys kept for decrypting data written before key rotation was introduced.
# Remove these once you have run the migration script (scripts/migrateMessageEncryption.js).
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# ── Email Delivery Configuration ───────────────────────────────────────────
# Option 1: Google Apps Script Web App (Recommended for Render/Cloud - HTTPS Port 443, zero SMTP blocking)
EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec
EMAIL_WEBHOOK_SECRET=your_auth_token_here

# Option 2: Brevo REST API (HTTPS Port 443, 300 free emails/day)
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Option 3: Gmail SMTP (requires 16-char App Password at myaccount.google.com/apppasswords)
# SMTP_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_16_char_gmail_app_password

# Option 4: Standard SMTP (Brevo, SendGrid, Amazon SES, Mailgun, cPanel, etc.)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password

# Option 5: Resend API (requires verified domain for public recipient emails)
# RESEND_API_KEY=re_your_api_key_here

EMAIL_FROM=samvada.real.time.chat@gmail.com
EMAIL_FROM_NAME="Samवाद"
CLIENT_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

ARCJET_KEY=your_arcjet_key
ARCJET_ENV=development
UPSTASH_REDIS_URL=redis://default:your_upstash_redis_token@your-endpoint.upstash.io:6379
